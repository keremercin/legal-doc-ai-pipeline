# App
APP_ENV=dev
APP_NAME=Legal Doc AI Pipeline
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# LLM & Embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
CLASSIFIER_MODE=auto

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_doc_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Retrieval backend: memory | pgvector
RETRIEVER_BACKEND=pgvector

# Vector
VECTOR_DIM=1536
TOP_K=5
HYBRID_KEYWORD_BOOST=0.15

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# OCR
OCR_ENGINE=tesseract
